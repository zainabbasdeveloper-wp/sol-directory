{
  "color": {
    "navy": "#0B2D5C",
    "primary": "#1769E0",
    "primaryBright": "#2F80ED",
    "primaryTint": "#F2F7FF",
    "pageBg": "#F5F8FC",
    "surface": "#FFFFFF",
    "text": "#10233F",
    "textMuted": "#5A6B84",
    "border": "#E8EEF7",
    "borderStrong": "#DDE4EF",
    "borderCard": "#E4EAF3",
    "rowDivider": "#EEF2F8",
    "rowHover": "#F7FAFE",
    "trackBg": "#EDF2F9",
    "disabledBg": "#E4EAF3",
    "ok": { "fg": "#177C4B", "bg": "#F1F9F4", "border": "#B6DBC5" },
    "warn": { "fg": "#8A5A16", "bg": "#FDF8EE", "border": "#E8D2A6", "dot": "#C98A1B" },
    "bad": { "fg": "#8C2F1E", "bg": "#FDF3F1", "border": "#E3B7B0", "dot": "#C2472C" },
    "flatDot": "#CBD5E1"
  },
  "gradient": {
    "primaryCta": "linear-gradient(135deg, #1769E0 0%, #2F80ED 100%)",
    "progress": "linear-gradient(90deg, #1769E0 0%, #2F80ED 100%)",
    "navyOverlay": "linear-gradient(165deg, rgba(11,45,92,0.86) 0%, rgba(11,45,92,0.97) 62%)"
  },
  "radius": {
    "input": "6px",
    "card": "8px",
    "roleCard": "10px",
    "formCard": "12px",
    "loginShell": "4px",
    "pill": "4px",
    "round": "100px"
  },
  "shadow": {
    "card": "0 1px 2px color-mix(in srgb, #0B2D5C 4%, transparent)",
    "formCard": "0 6px 22px color-mix(in srgb, #0B2D5C 6%, transparent)",
    "hoverLift": "0 12px 30px color-mix(in srgb, #0B2D5C 12%, transparent)",
    "loginShell": "0 30px 80px color-mix(in srgb, #0B2D5C 14%, transparent), 0 2px 6px color-mix(in srgb, #0B2D5C 6%, transparent)",
    "ctaRest": "0 10px 24px color-mix(in srgb, #1769E0 30%, transparent)",
    "ctaHover": "0 14px 32px color-mix(in srgb, #1769E0 34%, transparent)",
    "focusRing": "0 0 0 3px rgba(23,105,224,0.10)"
  },
  "type": {
    "family": "Barlow, system-ui, sans-serif",
    "pageTitle": { "size": "clamp(26px, 2.6vw, 33px)", "weight": 700, "tracking": "-0.03em", "lineHeight": 1.1 },
    "signupTitle": { "size": "clamp(30px, 3.4vw, 42px)", "weight": 700, "tracking": "-0.033em", "lineHeight": 1.1 },
    "loginAsideTitle": { "size": "clamp(30px, 3.2vw, 44px)", "weight": 700, "tracking": "-0.03em", "lineHeight": 1.1 },
    "sectionTitle": { "size": "19px", "weight": 700, "tracking": "-0.02em" },
    "cardTitle": { "size": "17.5px", "weight": 700, "tracking": "-0.02em" },
    "kpiValue": { "size": "32px", "weight": 700, "tracking": "-0.035em", "lineHeight": 1, "numeric": "tabular-nums" },
    "body": { "size": "15px", "lineHeight": 1.6 },
    "bodyLarge": { "size": "16px", "lineHeight": 1.68 },
    "meta": { "size": "13.5px", "lineHeight": 1.55 },
    "label": { "size": "13px", "weight": 600 },
    "eyebrow": { "size": "12px", "weight": 700, "tracking": "0.14em", "transform": "uppercase" },
    "pill": { "size": "11.5px", "weight": 700, "tracking": "0.07em", "transform": "uppercase" }
  },
  "size": {
    "inputHeight": "48px",
    "ctaHeight": "52px",
    "decisionCtaHeight": "50px",
    "roleCardMinHeight": "186px",
    "progressBarHeight": "6px",
    "avatar": "48px",
    "checkbox": "20px",
    "radioIndicator": "20px",
    "minTapTarget": "44px"
  },
  "layout": {
    "appMaxWidth": "1400px",
    "signupMaxWidth": "1040px",
    "loginMaxWidth": "1280px",
    "planMaxWidth": "1240px",
    "formColumnMaxWidth": "460px",
    "proseMaxWidth": "78ch",
    "breakpoints": { "mid": 900, "wide": 1040, "leadGrid2": 760, "leadGrid3": 1200, "kpi4": 1040, "kpi2": 640 }
  },
  "motion": {
    "screenIn": "screenIn 520-640ms cubic-bezier(.16,1,.3,1) both",
    "barIn": "barIn 900ms cubic-bezier(.16,1,.3,1) both",
    "numIn": "numIn 520ms cubic-bezier(.16,1,.3,1) both",
    "hoverLift": "transform 260ms cubic-bezier(.2,.8,.25,1)",
    "stateChange": "200-240ms ease",
    "staggerRoleCards": "90ms",
    "staggerKpi": "60ms",
    "toastDuration": "3400ms"
  }
}
