{
  "name": "soldirectory/cms",
  "description": "Headless WordPress for SolDirectory — content only, no public-facing theme rendering.",
  "type": "project",
  "repositories": [
    { "type": "composer", "url": "https://wpackagist.org" }
  ],
  "require": {
    "php": ">=8.0",
    "johnpbloch/wordpress-core": "^6.5",
    "vlucas/phpdotenv": "^5.6"
  },
  "extra": {
    "wordpress-install-dir": "wordpress"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true
    }
  }
}
