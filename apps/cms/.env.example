# Database
DB_NAME=soldirectory_cms
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# Public URL this WordPress install is served from (no trailing slash)
WP_SITE_URL=http://localhost:8080

# Generate real random values for all 8 of these at:
# https://api.wordpress.org/secret-key/1.1/salt/
# Never reuse the placeholders below in a real deployment.
WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=

WP_DEBUG=false

# Must match apps/web's dev/prod origin exactly, for the CORS headers
# the custom plugin adds to the REST API — see
# wp-content/plugins/soldirectory-content/includes/rest-api.php
FRONTEND_ORIGIN=http://localhost:5173
