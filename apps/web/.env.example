# Every variable below was found by grepping VITE_* across the actual
# apps/web/src codebase.

# Base URL of your Node API — same-origin in production behind nginx
# (e.g. /api), or a full URL in local dev.
VITE_API_URL=http://localhost:4000/api

# Browser-side, PUBLIC Mapbox access token (starts with "pk."), used
# by components/ProviderMap.tsx (Mapbox GL JS). Different from the
# server-side MAPBOX_ACCESS_TOKEN in apps/api/.env by design — that
# one is a secret token and must never end up here, since Vite bakes
# every VITE_* variable directly into the shipped browser bundle.
# In the Mapbox dashboard, scope this token to styles:read, fonts:read
# and styles:tiles, and add a URL restriction for your domain(s).
# Without this, the map area renders a "Map unavailable" state with a
# console warning, not a crash and not a blank box.
VITE_MAPBOX_ACCESS_TOKEN=

# NO LONGER READ BY ANYTHING as of the WordPress CORS proxy fix —
# wordpressApi.ts now routes every WordPress request through
# VITE_API_URL + /wp/rest/... (same-origin, no CORS) instead of
# fetching WordPress directly. Safe to delete this variable entirely;
# keeping it set does nothing.
VITE_WORDPRESS_URL=
