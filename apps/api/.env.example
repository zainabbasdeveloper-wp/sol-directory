# Every variable below was found by grepping process.env.* across the
# actual apps/api/src codebase — nothing here is guessed or invented.
# Group headers show which real files/features each variable feeds.

# --- Server ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/soldirectory
JWT_SECRET=
# Must exactly match your deployed frontend origin — used both for
# the main CORS policy (index.ts) and to build links in transactional
# emails and the password-reset URL (auth.controller.ts).
CLIENT_ORIGIN=http://localhost:5173

# --- Email (services/email.service.ts) ---
# Set SMTP_URL, or set all four SMTP_HOST/PORT/USER/PASSWORD values.
# EmailService silently no-ops and logs a warning when neither form is
# configured, so lead submissions are never lost when email is down.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SolDirectory <no-reply@yourdomain.com>
# Recipient for "new provider registered" admin alerts
# (auth.controller.ts). Not required — that email simply doesn't
# send if unset.
ADMIN_NOTIFICATION_EMAIL=

# --- Geocoding (services/geocoding.service.ts) ---
# Server-side SECRET Mapbox access token (starts with "sk."), used
# for the Mapbox Geocoding API — different from the browser-side
# VITE_MAPBOX_ACCESS_TOKEN in apps/web/.env by design (that one must
# be a public, domain-restricted token; this one must never be sent
# to the browser).
MAPBOX_ACCESS_TOKEN=

# --- WordPress integration (routes/wp.routes.ts) ---
# WORDPRESS_URL is the REST API base the Node proxy forwards to
# (/api/wp/rest/...) — this is what actually resolved the CORS issue,
# since the browser only ever talks to this Node API now.
WORDPRESS_URL=http://46.250.242.208:8080
# Only used if you also call the existing GraphQL proxy
# (/api/wp/graphql) — the REST integration (wordpressApi.ts) doesn't
# need this.
WORDPRESS_GRAPHQL_URL=

# --- WordPress webhook (routes/webhooks.routes.ts) ---
# Must exactly match the same value in apps/cms/.env — WordPress
# sends this in the X-Webhook-Secret header to prove a content-change
# notification actually came from your CMS, not an arbitrary request.
WEBHOOK_SECRET=

# --- WordPress provider sync (services/wordpressSync.service.ts) ---
# WordPress Application Password credentials — create a user in
# wp-admin (Editor role is enough), then under that user's profile,
# "Application Passwords" -> generate one named e.g. "provider-sync".
# Used as HTTP Basic Auth to create/update the 'provider' CPT mirror
# post on every onboarding save and admin status change. Without
# these, provider sync silently no-ops (logged, never blocks the
# calling request) — same reliability principle as GOOGLE/MAPBOX keys
# above.
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# --- Sitemap (controllers/sitemap.controller.ts) ---
# Absolute base URL used to build <loc> entries. Falls back to
# request host if unset, but that's unreliable behind a reverse
# proxy — set this explicitly in production.
SITE_URL=http://46.250.242.208

# --- NOT YET ACTIVE — real code exists but is stubbed, not wired to
# a real provider yet. Setting these does nothing until the
# corresponding service is implemented for real:
#
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_BUCKET / S3_REGION
#   — services/s3.service.ts ships a stub that returns fake upload/
#   download URLs. Verification documents currently go nowhere real.
#   See that file's own header comment for what a real implementation
#   needs to satisfy.
#
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
#   — services/stripe.service.ts's webhook signature check is a stub,
#   not real stripe.webhooks.constructEvent verification yet.
