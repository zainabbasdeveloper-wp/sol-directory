PORT=4000
MONGODB_URI=mongodb://localhost:27017/soldirectory
JWT_SECRET=change-this-in-production
CLIENT_ORIGIN=http://localhost:5173

# S3 / object storage — verification documents. Never store raw
# files in MongoDB; only the metadata (see DocumentAsset model).
S3_BUCKET=soldirectory-documents
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# Stripe — subscription is webhook-owned; the client never sets its
# own plan. See services/stripe.service.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WORDPRESS_GRAPHQL_URL=https://www.solbusinessconsultant.com.au/graphql
